# Dependencies
node_modules/
vendor/

# Environment files
.env
.env.*
!.env.example

# Build & compiled assets
dist/
/public/build
/public/hot
/public/storage

# Storage and uploads (Laravel)
storage/*.key
storage/app/public/*
!storage/app/public/.gitignore
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
!storage/logs/.gitignore

# Database (keep migrations & seeders, ignore local sqlite data)
*.sqlite
*.sqlite-journal
*.sqlite3

# Archives & Temporary files
*.zip
*.tar.gz
*.rar
*.7z

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
/.fleet
/.nova
/.zed

